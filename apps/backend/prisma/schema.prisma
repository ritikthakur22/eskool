generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id               String            @id @default(uuid())
  name             String
  address          String?
  phone            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  feeInvoices      FeeInvoice[]
  feePaymentProofs FeePaymentProof[]
  routineDocuments RoutineDocument[]
  users            User[]
}

model User {
  id                       String               @id @default(uuid())
  email                    String               @unique
  password                 String
  role                     Role
  schoolId                 String
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  googleSubject            String?              @unique
  googleEmail              String?
  profilePicture           Bytes?
  profilePictureMimeType   String?
  adminProfile             AdminProfile?
  studentAttendances       Attendance[]         @relation("StudentAttendance")
  markedAttendances        Attendance[]         @relation("TeacherAttendance")
  studentResults           ExamResult[]         @relation("StudentResults")
  feeInvoices              FeeInvoice[]         @relation("StudentFeeInvoices")
  feePaymentProofs         FeePaymentProof[]    @relation("StudentFeePaymentProofs")
  teacherHomeworks         Homework[]           @relation("TeacherHomework")
  studentSubmissions       HomeworkSubmission[] @relation("StudentSubmission")
  authoredNotices          Notice[]             @relation("NoticeAuthor")
  uploadedRoutineDocuments RoutineDocument[]
  studentProfile           StudentProfile?
  teacherProfile           TeacherProfile?
  school                   School               @relation(fields: [schoolId], references: [id])
}

model FeeInvoice {
  id            String            @id @default(uuid())
  schoolId      String
  studentId     String
  invoiceNumber String
  title         String
  description   String?
  amount        Decimal           @db.Decimal(10, 2)
  dueDate       DateTime
  status        FeeInvoiceStatus  @default(DUE)
  issuedAt      DateTime          @default(now())
  paidAt        DateTime?
  school        School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student       User              @relation("StudentFeeInvoices", fields: [studentId], references: [id], onDelete: Cascade)
  paymentProofs FeePaymentProof[]

  @@unique([schoolId, invoiceNumber])
  @@index([schoolId, studentId, dueDate])
}

model RoutineDocument {
  id         String   @id @default(uuid())
  schoolId   String
  uploaderId String
  fileName   String
  mimeType   String
  content    Bytes
  createdAt  DateTime @default(now())
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  uploader   User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
}

model FeePaymentProof {
  id            String                @id @default(uuid())
  schoolId      String
  studentId     String
  invoiceId     String
  mobileNumber  String
  method        FeePaymentMethod
  transactionId String
  amount        Decimal               @db.Decimal(10, 2)
  status        FeePaymentProofStatus @default(PENDING)
  submittedAt   DateTime              @default(now())
  invoice       FeeInvoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  school        School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student       User                  @relation("StudentFeePaymentProofs", fields: [studentId], references: [id], onDelete: Cascade)
  files         FeePaymentProofFile[]

  @@index([schoolId, studentId, submittedAt])
  @@index([invoiceId, submittedAt])
}

model FeePaymentProofFile {
  id       String          @id @default(uuid())
  proofId  String
  fileName String
  mimeType String
  content  Bytes
  proof    FeePaymentProof @relation(fields: [proofId], references: [id], onDelete: Cascade)

  @@index([proofId])
}

model Homework {
  id          String               @id @default(uuid())
  title       String
  description String
  dueDate     DateTime
  subject     String
  teacherId   String
  classId     String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  teacher     User                 @relation("TeacherHomework", fields: [teacherId], references: [id])
  submissions HomeworkSubmission[]
}

model HomeworkSubmission {
  id          String   @id @default(uuid())
  homeworkId  String
  studentId   String
  content     String?
  fileUrl     String?
  status      String
  grade       String?
  feedback    String?
  submittedAt DateTime @default(now())
  homework    Homework @relation(fields: [homeworkId], references: [id])
  student     User     @relation("StudentSubmission", fields: [studentId], references: [id])
}

model Attendance {
  id        String           @id @default(uuid())
  studentId String
  teacherId String?
  date      DateTime
  status    AttendanceStatus
  subject   String?
  remarks   String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  student   User             @relation("StudentAttendance", fields: [studentId], references: [id])
  teacher   User?            @relation("TeacherAttendance", fields: [teacherId], references: [id])
}

model StudentProfile {
  id                     String    @id @default(uuid())
  userId                 String    @unique
  firstName              String
  lastName               String
  grade                  String?
  section                String?
  dob                    DateTime?
  rollNo                 String?
  phone                  String?
  gender                 String?
  address                String?
  profilePicture         Bytes?
  profilePictureMimeType String?
  parentName             String?
  parentPhone            String?
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeacherProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  firstName String
  lastName  String
  subjects  String[]
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminProfile {
  id         String  @id @default(uuid())
  userId     String  @unique
  firstName  String
  lastName   String
  department String?
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notice {
  id        String   @id @default(uuid())
  title     String
  content   String
  category  String
  authorId  String
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation("NoticeAuthor", fields: [authorId], references: [id])
}

model Exam {
  id      String       @id @default(uuid())
  title   String
  date    DateTime
  classId String
  results ExamResult[]
}

model ExamResult {
  id            String  @id @default(uuid())
  examId        String
  studentId     String
  subject       String
  marksObtained Float
  totalMarks    Float
  grade         String?
  exam          Exam    @relation(fields: [examId], references: [id])
  student       User    @relation("StudentResults", fields: [studentId], references: [id])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
}

enum FeeInvoiceStatus {
  DUE
  OVERDUE
  PAID
}

enum FeePaymentMethod {
  WALLET
  BANK_TRANSFER
}

enum FeePaymentProofStatus {
  PENDING
  APPROVED
  REJECTED
}
