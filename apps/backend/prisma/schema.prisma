generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id               String               @id @default(uuid())
  name             String
  address          String?
  logo             Bytes?
  logoMimeType     String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  timezone         String               @default("UTC")
  status           String               @default("ACTIVE")
  settings         Json?
  feeInvoices      FeeInvoice[]
  feePaymentProofs FeePaymentProof[]
  routineDocuments RoutineDocument[]
  users            User[]
  academicYears    AcademicYear[]
  classes          Class[]
  sections         Section[]
  subjects         Subject[]
  attendances      Attendance[]
  homeworks        Homework[]
  submissions      HomeworkSubmission[]
  notices          Notice[]
  exams            Exam[]
  examResults      ExamResult[]
  auditLogs        AuditLog[]
  conversations    Conversation[]
  classRoutines    ClassRoutine[]
}

model AcademicYear {
  id                 String              @id @default(uuid())
  schoolId           String
  name               String // e.g., "2026-2027"
  startDate          DateTime
  endDate            DateTime
  isCurrent          Boolean             @default(false)
  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments        Enrollment[]
  teacherAssignments TeacherAssignment[]

  @@unique([schoolId, name])
}

model Class {
  id       String    @id @default(uuid())
  schoolId String
  name     String // e.g., "Class 10"
  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections Section[]

  @@unique([schoolId, name])
}

model Section {
  id                 String              @id @default(uuid())
  schoolId           String
  classId            String
  name               String // e.g., "A"
  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class              Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  enrollments        Enrollment[]
  teacherAssignments TeacherAssignment[]
  exams              Exam[]
  homeworks          Homework[]
  classRoutines      ClassRoutine[]

  @@unique([classId, name])
}

model Subject {
  id                 String              @id @default(uuid())
  schoolId           String
  name               String // e.g., "Mathematics"
  code               String?
  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherAssignments TeacherAssignment[]
  homeworks          Homework[]
  exams              Exam[]
  classRoutines      ClassRoutine[]

  @@unique([schoolId, name])
}

model Enrollment {
  id             String       @id @default(uuid())
  studentId      String
  sectionId      String
  academicYearId String
  rollNo         String?
  student        User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section        Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId])
}

model TeacherAssignment {
  id             String       @id @default(uuid())
  teacherId      String
  sectionId      String
  subjectId      String
  academicYearId String
  teacher        User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  section        Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([teacherId, sectionId, subjectId, academicYearId])
}

model ParentStudent {
  id        String @id @default(uuid())
  parentId  String
  studentId String
  parent    User   @relation("ParentToStudent", fields: [parentId], references: [id], onDelete: Cascade)
  student   User   @relation("StudentToParent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
}

model User {
  id                       String               @id @default(uuid())
  email                    String               @unique
  password                 String
  role                     Role
  schoolId                 String
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  googleSubject            String?              @unique
  googleEmail              String?
  profilePicture           Bytes?
  profilePictureMimeType   String?
  profilePictureUrl        String?
  profilePicturePublicId   String?
  status                   String               @default("ACTIVE")
  disabledAt               DateTime?
  tokenVersion             Int                  @default(0)
  adminProfile             AdminProfile?
  studentAttendances       Attendance[]         @relation("StudentAttendance")
  markedAttendances        Attendance[]         @relation("TeacherAttendance")
  studentResults           ExamResult[]         @relation("StudentResults")
  examAttempts             ExamAttempt[]        @relation("StudentExamAttempts")
  feeInvoices              FeeInvoice[]         @relation("StudentFeeInvoices")
  feePaymentProofs         FeePaymentProof[]    @relation("StudentFeePaymentProofs")
  teacherHomeworks         Homework[]           @relation("TeacherHomework")
  studentSubmissions       HomeworkSubmission[] @relation("StudentSubmission")
  authoredNotices          Notice[]             @relation("NoticeAuthor")
  uploadedRoutineDocuments RoutineDocument[]
  studentProfile           StudentProfile?
  teacherProfile           TeacherProfile?
  school                   School               @relation(fields: [schoolId], references: [id])
  sessions                 AuthSession[]
  enrollments              Enrollment[]
  teacherAssignments       TeacherAssignment[]
  parentStudents           ParentStudent[]      @relation("ParentToStudent")
  studentParents           ParentStudent[]      @relation("StudentToParent")
  auditLogs                AuditLog[]
  conversations            ConversationParticipant[]
  messages                 Message[]
  classRoutines            ClassRoutine[]
}

model AuthSession {
  id           String    @id @default(uuid())
  userId       String
  tokenHash    String    @unique
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  replacedById String?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
}

model FeeInvoice {
  id            String            @id @default(uuid())
  schoolId      String
  studentId     String
  invoiceNumber String
  title         String
  description   String?
  amount        Decimal           @db.Decimal(10, 2)
  dueDate       DateTime
  status        FeeInvoiceStatus  @default(DUE)
  issuedAt      DateTime          @default(now())
  paidAt        DateTime?
  school        School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student       User              @relation("StudentFeeInvoices", fields: [studentId], references: [id], onDelete: Cascade)
  paymentProofs FeePaymentProof[]

  @@unique([schoolId, invoiceNumber])
  @@index([schoolId, studentId, dueDate])
}

model RoutineDocument {
  id         String   @id @default(uuid())
  schoolId   String
  uploaderId String
  fileName   String
  mimeType   String
  storageUrl String?
  publicId   String?
  createdAt  DateTime @default(now())
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  uploader   User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
}

model FeePaymentProof {
  id            String                @id @default(uuid())
  schoolId      String
  studentId     String
  invoiceId     String
  mobileNumber  String
  method        FeePaymentMethod
  transactionId String
  amount        Decimal               @db.Decimal(10, 2)
  status        FeePaymentProofStatus @default(PENDING)
  submittedAt   DateTime              @default(now())
  invoice       FeeInvoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  school        School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student       User                  @relation("StudentFeePaymentProofs", fields: [studentId], references: [id], onDelete: Cascade)
  files         FeePaymentProofFile[]

  @@index([schoolId, studentId, submittedAt])
  @@index([invoiceId, submittedAt])
}

model FeePaymentProofFile {
  id         String          @id @default(uuid())
  proofId    String
  fileName   String
  mimeType   String
  storageUrl String?
  publicId   String?
  proof      FeePaymentProof @relation(fields: [proofId], references: [id], onDelete: Cascade)

  @@index([proofId])
}

model Homework {
  id          String               @id @default(uuid())
  schoolId    String
  title       String
  description String
  dueDate     DateTime
  subjectId   String
  teacherId   String
  sectionId   String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  school      School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher     User                 @relation("TeacherHomework", fields: [teacherId], references: [id])
  subject     Subject              @relation(fields: [subjectId], references: [id])
  section     Section?             @relation(fields: [sectionId], references: [id])
  attachmentUrl String?
  attachmentType String?
  submissions HomeworkSubmission[]

  @@index([schoolId, teacherId, sectionId])
}

model HomeworkSubmission {
  id          String   @id @default(uuid())
  schoolId    String
  homeworkId  String
  studentId   String
  content     String?
  fileUrl     String?
  status      String
  grade       String?
  feedback    String?
  submittedAt DateTime @default(now())
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  homework    Homework @relation(fields: [homeworkId], references: [id])
  student     User     @relation("StudentSubmission", fields: [studentId], references: [id])

  @@unique([homeworkId, studentId])
}

model Attendance {
  id        String           @id @default(uuid())
  schoolId  String
  studentId String
  teacherId String?
  date      DateTime
  status    AttendanceStatus
  subject   String?
  remarks   String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  school    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student   User             @relation("StudentAttendance", fields: [studentId], references: [id])
  teacher   User?            @relation("TeacherAttendance", fields: [teacherId], references: [id])

  @@unique([studentId, date])
}

model StudentProfile {
  id                     String    @id @default(uuid())
  userId                 String    @unique
  firstName              String
  lastName               String
  grade                  String?
  section                String?
  dob                    DateTime?
  rollNo                 String?
  phone                  String?
  gender                 String?
  address                String?
  profilePicture         Bytes?
  profilePictureMimeType String?
  parentName             String?
  parentPhone            String?
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeacherProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  firstName String
  lastName  String
  subjects  String[]
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminProfile {
  id         String  @id @default(uuid())
  userId     String  @unique
  firstName  String
  lastName   String
  department String?
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notice {
  id             String   @id @default(uuid())
  schoolId       String
  title          String
  content        String
  category       String
  authorId       String
  date           DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  attachmentUrl  String?
  attachmentType String?
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  author         User     @relation("NoticeAuthor", fields: [authorId], references: [id])

  @@index([schoolId, date])
}

model Exam {
  id              String       @id @default(uuid())
  schoolId        String
  title           String
  date            DateTime
  subjectId       String
  sectionId       String
  type            String       @default("STANDARD") // "STANDARD" or "MCQ"
  durationMinutes Int?
  
  school          School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject         Subject      @relation(fields: [subjectId], references: [id])
  section         Section      @relation(fields: [sectionId], references: [id])
  results         ExamResult[]
  questions       ExamQuestion[]
  attempts        ExamAttempt[]

  @@index([schoolId, sectionId, subjectId])
}

model ExamResult {
  id            String  @id @default(uuid())
  schoolId      String
  examId        String
  studentId     String
  marksObtained Float
  totalMarks    Float
  grade         String?
  school        School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  exam          Exam    @relation(fields: [examId], references: [id])
  student       User    @relation("StudentResults", fields: [studentId], references: [id])

  @@unique([examId, studentId])
}

model AuditLog {
  id        String   @id @default(uuid())
  schoolId  String?
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  userAgent String?
  requestId String?
  createdAt DateTime @default(now())
  school    School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([userId, createdAt])
}

model AuditOutbox {
  id        String   @id @default(uuid())
  payload   Json
  status    String   @default("PENDING") // PENDING, PROCESSED, FAILED
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
}

enum FeeInvoiceStatus {
  DUE
  OVERDUE
  PAID
}

enum FeePaymentMethod {
  WALLET
  BANK_TRANSFER
}

enum FeePaymentProofStatus {
  PENDING
  APPROVED
  REJECTED
}

model Conversation {
  id        String   @id @default(uuid())
  schoolId  String
  name      String?
  type      ConversationType @default(INDIVIDUAL)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages  Message[]

  @@index([schoolId])
}

model ConversationParticipant {
  id             String   @id @default(uuid())
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  isFlagged      Boolean  @default(false)

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

enum ConversationType {
  INDIVIDUAL
  GROUP
}

model ExamQuestion {
  id                 String   @id @default(uuid())
  examId             String
  text               String
  marks              Int      @default(1)
  options            String[] 
  correctOptionIndex Int
  
  exam               Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
}

model ExamAttempt {
  id          String   @id @default(uuid())
  examId      String
  studentId   String
  startedAt   DateTime @default(now())
  completedAt DateTime?
  score       Int?
  answers     Json?     
  
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  student     User     @relation("StudentExamAttempts", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
}

model ClassRoutine {
  id        String   @id @default(uuid())
  schoolId  String
  sectionId String
  subjectId String
  teacherId String
  dayOfWeek Int
  startTime String
  endTime   String

  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([schoolId, sectionId])
  @@index([teacherId])
}
