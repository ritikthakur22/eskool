# Runtime configuration (never commit the real .env file)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
# Optional direct connection used by migration/administration tooling.
DIRECT_URL="postgresql://user:password@host/database?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=3000

# Browser clients only; native mobile clients do not send an Origin header.
CORS_ORIGINS="https://your-web-app.example.com"

# Cloudinary is the planned private media store for profile photos,
# routine documents, homework attachments, and payment proofs.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Fee payment display configuration
FEE_BANK_NAME="Global IME Bank"
FEE_BANK_ACCOUNT_NAME="eSkool Pvt. Ltd."
FEE_BANK_ACCOUNT_NUMBER="replace-me"
FEE_BANK_QR_URL=""

# Development seed only; never configure these in production.
SEED_ADMIN_PASSWORD=""
DEMO_SEED_PASSWORDS_JSON=""
